# Copy to secrets.env and fill in. secrets.env is gitignored.

# --- SSH / WP-CLI (primary control channel) ---
SSH_HOST=your-server.hostinger.com
SSH_PORT=22
SSH_USER=u123456789
# Provide ONE of SSH_KEY (path to private key) or SSH_PASS:
SSH_KEY=
SSH_PASS=
# Remote WordPress root used for `wp --path=...` (find with: ls ~/domains/<domain>/public_html):
WP_PATH=/home/u123456789/domains/example.com/public_html

# --- WP REST API (fallback control channel) ---
WP_URL=https://example.com
WP_ADMIN_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Media APIs ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- AdSense ---
ADSENSE_PUB_ID=

# --- Cloudflare (DNS + CDN/proxy in front of the Hostinger origin) ---
# Optional for Gate 1. Needed later for QA cache-purge + HTTPS/SSL checks (Plan E).
# Create a scoped API token (My Profile -> API Tokens) with, for THIS zone:
#   Zone > Cache Purge: Purge, Zone > Zone Settings: Read, Zone > DNS: Read
CLOUDFLARE_API_TOKEN=
CF_ZONE_ID=
