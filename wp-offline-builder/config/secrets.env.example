# Copy to secrets.env and fill in. secrets.env is gitignored.
# This agent builds LOCALLY under XAMPP - no SSH, no DNS, no SSL, no hosting.

# --- Mode ---
# 'local' selects the XAMPP/local control channel (vs. the remote agent's SSH channel).
MODE=local

# --- Site identity ---
# Slug used for the htdocs folder and the localhost URL.
SITE_SLUG=offline-site
# WordPress root under XAMPP htdocs (this is where core gets installed):
WP_PATH=C:\xampp\htdocs\offline-site
# Local URL served by Apache (no domain, no HTTPS):
WP_URL=http://localhost/offline-site

# --- Local toolchain (XAMPP) ---
# PHP shipped with XAMPP - runs wp-cli.phar:
LOCAL_PHP=C:\xampp\php\php.exe
# wp-cli.phar - download once into bin/ (see bin/README.md):
WP_CLI_PHAR=D:\1Agent1\wp-offline-builder\bin\wp-cli.phar
# MySQL client binary from XAMPP - used to create/inspect the database:
MYSQL_BIN=C:\xampp\mysql\bin\mysql.exe

# --- Database (XAMPP MySQL; default root has no password) ---
DB_NAME=offline_site
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1

# --- Media APIs (the only thing fetched online - once, during the build) ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- WordPress admin (created during install) ---
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin@123789
WP_ADMIN_EMAIL=admin@example.com
